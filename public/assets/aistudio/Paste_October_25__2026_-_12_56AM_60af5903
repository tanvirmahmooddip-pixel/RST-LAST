CREATE DATABASE IF NOT EXISTS rst_electronics
  CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE rst_electronics;

CREATE TABLE branches (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(120) NOT NULL,
  code VARCHAR(30) NOT NULL UNIQUE,
  phone VARCHAR(30),
  address VARCHAR(255),
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

CREATE TABLE users (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  branch_id INT UNSIGNED NULL,
  username VARCHAR(60) NOT NULL UNIQUE,
  full_name VARCHAR(120) NOT NULL,
  role ENUM('master_admin','admin','manager','cashier','sales','store','accountant','hr','viewer') NOT NULL DEFAULT 'sales',
  password_hash VARCHAR(255) NULL,
  is_active TINYINT(1) NOT NULL DEFAULT 1,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (branch_id) REFERENCES branches(id) ON DELETE SET NULL
) ENGINE=InnoDB;

CREATE TABLE categories (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(100) NOT NULL,
  parent_id INT UNSIGNED NULL,
  FOREIGN KEY (parent_id) REFERENCES categories(id) ON DELETE SET NULL
) ENGINE=InnoDB;

CREATE TABLE brands (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(100) NOT NULL UNIQUE
) ENGINE=InnoDB;

CREATE TABLE suppliers (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(160) NOT NULL,
  phone VARCHAR(30),
  whatsapp VARCHAR(30),
  email VARCHAR(120),
  address VARCHAR(255),
  opening_balance DECIMAL(15,3) NOT NULL DEFAULT 0,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

CREATE TABLE customers (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(160) NOT NULL,
  phone VARCHAR(30),
  whatsapp VARCHAR(30),
  email VARCHAR(120),
  address VARCHAR(255),
  opening_balance DECIMAL(15,3) NOT NULL DEFAULT 0,
  credit_limit DECIMAL(15,3) NOT NULL DEFAULT 0,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

CREATE TABLE products (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  sku VARCHAR(80) NOT NULL UNIQUE,
  barcode VARCHAR(100) UNIQUE,
  imei VARCHAR(80) NULL UNIQUE,
  name VARCHAR(180) NOT NULL,
  category_id INT UNSIGNED NULL,
  brand_id INT UNSIGNED NULL,
  unit VARCHAR(20) NOT NULL DEFAULT 'pcs',
  cost_price DECIMAL(15,3) NOT NULL DEFAULT 0,
  sale_price DECIMAL(15,3) NOT NULL DEFAULT 0,
  vat_rate DECIMAL(5,2) NOT NULL DEFAULT 5.00,
  min_stock DECIMAL(15,3) NOT NULL DEFAULT 0,
  active TINYINT(1) NOT NULL DEFAULT 1,
  warranty_months INT UNSIGNED NOT NULL DEFAULT 0,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (category_id) REFERENCES categories(id) ON DELETE SET NULL,
  FOREIGN KEY (brand_id) REFERENCES brands(id) ON DELETE SET NULL,
  INDEX idx_product_name(name)
) ENGINE=InnoDB;

CREATE TABLE warehouses (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  branch_id INT UNSIGNED NOT NULL,
  name VARCHAR(120) NOT NULL,
  code VARCHAR(30) NOT NULL UNIQUE,
  FOREIGN KEY (branch_id) REFERENCES branches(id) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE stock (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  warehouse_id INT UNSIGNED NOT NULL,
  product_id INT UNSIGNED NOT NULL,
  qty DECIMAL(15,3) NOT NULL DEFAULT 0,
  UNIQUE KEY uq_stock(warehouse_id, product_id),
  FOREIGN KEY (warehouse_id) REFERENCES warehouses(id) ON DELETE CASCADE,
  FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE stock_moves (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  warehouse_id INT UNSIGNED NOT NULL,
  product_id INT UNSIGNED NOT NULL,
  move_type ENUM('purchase','sale','return_in','return_out','transfer_in','transfer_out','adjustment','damage') NOT NULL,
  qty DECIMAL(15,3) NOT NULL,
  unit_cost DECIMAL(15,3) NOT NULL DEFAULT 0,
  ref_type VARCHAR(30),
  ref_id BIGINT UNSIGNED NULL,
  note VARCHAR(255),
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (warehouse_id) REFERENCES warehouses(id),
  FOREIGN KEY (product_id) REFERENCES products(id),
  INDEX idx_stock_moves_product(product_id, created_at)
) ENGINE=InnoDB;

CREATE TABLE sales (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  invoice_no VARCHAR(50) NOT NULL UNIQUE,
  customer_id INT UNSIGNED NULL,
  branch_id INT UNSIGNED NOT NULL,
  warehouse_id INT UNSIGNED NOT NULL,
  user_id INT UNSIGNED NULL,
  subtotal DECIMAL(15,3) NOT NULL DEFAULT 0,
  discount DECIMAL(15,3) NOT NULL DEFAULT 0,
  vat_rate DECIMAL(5,2) NOT NULL DEFAULT 5.00,
  vat_amount DECIMAL(15,3) NOT NULL DEFAULT 0,
  total DECIMAL(15,3) NOT NULL DEFAULT 0,
  paid DECIMAL(15,3) NOT NULL DEFAULT 0,
  balance DECIMAL(15,3) NOT NULL DEFAULT 0,
  status ENUM('draft','posted','paid','partial','cancelled','returned') NOT NULL DEFAULT 'draft',
  sale_date DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE SET NULL,
  FOREIGN KEY (branch_id) REFERENCES branches(id),
  FOREIGN KEY (warehouse_id) REFERENCES warehouses(id),
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB;

CREATE TABLE sale_items (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  sale_id BIGINT UNSIGNED NOT NULL,
  product_id INT UNSIGNED NOT NULL,
  qty DECIMAL(15,3) NOT NULL,
  unit_price DECIMAL(15,3) NOT NULL,
  discount DECIMAL(15,3) NOT NULL DEFAULT 0,
  vat_rate DECIMAL(5,2) NOT NULL DEFAULT 5.00,
  vat_amount DECIMAL(15,3) NOT NULL DEFAULT 0,
  line_total DECIMAL(15,3) NOT NULL DEFAULT 0,
  FOREIGN KEY (sale_id) REFERENCES sales(id) ON DELETE CASCADE,
  FOREIGN KEY (product_id) REFERENCES products(id)
) ENGINE=InnoDB;

CREATE TABLE purchases (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  purchase_no VARCHAR(50) NOT NULL UNIQUE,
  supplier_id INT UNSIGNED NULL,
  branch_id INT UNSIGNED NOT NULL,
  warehouse_id INT UNSIGNED NOT NULL,
  subtotal DECIMAL(15,3) NOT NULL DEFAULT 0,
  discount DECIMAL(15,3) NOT NULL DEFAULT 0,
  vat_amount DECIMAL(15,3) NOT NULL DEFAULT 0,
  total DECIMAL(15,3) NOT NULL DEFAULT 0,
  paid DECIMAL(15,3) NOT NULL DEFAULT 0,
  balance DECIMAL(15,3) NOT NULL DEFAULT 0,
  status ENUM('draft','posted','paid','partial','cancelled') NOT NULL DEFAULT 'draft',
  purchase_date DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (supplier_id) REFERENCES suppliers(id) ON DELETE SET NULL,
  FOREIGN KEY (branch_id) REFERENCES branches(id),
  FOREIGN KEY (warehouse_id) REFERENCES warehouses(id)
) ENGINE=InnoDB;

CREATE TABLE purchase_items (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  purchase_id BIGINT UNSIGNED NOT NULL,
  product_id INT UNSIGNED NOT NULL,
  qty DECIMAL(15,3) NOT NULL,
  unit_cost DECIMAL(15,3) NOT NULL,
  vat_rate DECIMAL(5,2) NOT NULL DEFAULT 5.00,
  vat_amount DECIMAL(15,3) NOT NULL DEFAULT 0,
  line_total DECIMAL(15,3) NOT NULL DEFAULT 0,
  FOREIGN KEY (purchase_id) REFERENCES purchases(id) ON DELETE CASCADE,
  FOREIGN KEY (product_id) REFERENCES products(id)
) ENGINE=InnoDB;

CREATE TABLE payments (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  customer_id INT UNSIGNED NULL,
  supplier_id INT UNSIGNED NULL,
  sale_id BIGINT UNSIGNED NULL,
  purchase_id BIGINT UNSIGNED NULL,
  payment_type ENUM('sale','purchase','customer_receipt','supplier_payment','expense','income','refund') NOT NULL,
  method ENUM('cash','bank','card','transfer','other') NOT NULL DEFAULT 'cash',
  amount DECIMAL(15,3) NOT NULL,
  reference_no VARCHAR(80),
  note VARCHAR(255),
  paid_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE SET NULL,
  FOREIGN KEY (supplier_id) REFERENCES suppliers(id) ON DELETE SET NULL,
  FOREIGN KEY (sale_id) REFERENCES sales(id) ON DELETE SET NULL,
  FOREIGN KEY (purchase_id) REFERENCES purchases(id) ON DELETE SET NULL
) ENGINE=InnoDB;

CREATE TABLE expenses (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  title VARCHAR(160) NOT NULL,
  category VARCHAR(100),
  amount DECIMAL(15,3) NOT NULL,
  payment_method ENUM('cash','bank','card','transfer','other') NOT NULL DEFAULT 'cash',
  expense_date DATE NOT NULL,
  note VARCHAR(255)
) ENGINE=InnoDB;

CREATE TABLE employees (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  employee_code VARCHAR(40) NOT NULL UNIQUE,
  name VARCHAR(160) NOT NULL,
  phone VARCHAR(30),
  job_title VARCHAR(100),
  salary DECIMAL(15,3) NOT NULL DEFAULT 0,
  joining_date DATE NULL,
  status ENUM('active','inactive') NOT NULL DEFAULT 'active'
) ENGINE=InnoDB;

CREATE TABLE audit_logs (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  user_id INT UNSIGNED NULL,
  action VARCHAR(80) NOT NULL,
  table_name VARCHAR(80),
  record_id BIGINT UNSIGNED NULL,
  details JSON NULL,
  ip_address VARCHAR(45),
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB;

