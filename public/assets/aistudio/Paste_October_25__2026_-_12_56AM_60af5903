  public createInvoice(invData: Omit<Invoice, 'id' | 'invoice_no'>): Invoice {
    const nextNum = this.invoices.length + 1;
    const invoice_no = `${this.config.invoice_prefix}-${String(nextNum).padStart(5, '0')}`;
    const invoice: Invoice = {
      ...invData,
      id: nextNum,
      invoice_no
    };

    // Deduct stock
    invoice.items.forEach(item => {
      if (item.isComponent) {
        const comp = this.components.find(c => c.id === item.id);
        if (comp) comp.stock = Math.max(0, comp.stock - item.qty);
      } else {
        const prod = this.products.find(p => p.id === item.id);
        if (prod) prod.stock = Math.max(0, prod.stock - item.qty);
      }
    });

    this.invoices.unshift(invoice);

    // Update branch sales
    const b = this.branches.find(br => br.name === invoice.branch);
    if (b) {
      b.salesToday += invoice.grand_total;
    }

    this.addNotification({
      title: `Invoice ${invoice_no} Generated`,
      body: `Customer: ${invoice.customer} | Total: ${invoice.grand_total.toFixed(3)} ${this.config.currency}`,
      type: 'sale'
    });

    this.logAudit(`Invoice ${invoice_no} created for ${invoice.grand_total.toFixed(3)} ${this.config.currency}`, 'invoice', invoice_no);
    this.persist();
    return invoice;
  }

