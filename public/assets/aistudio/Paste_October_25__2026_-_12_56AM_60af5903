  // Helper: Calculate total working hours, overtime hours, and payroll pay
  public calculateWorkingHoursAndPay(
    checkInTime: string,
    checkOutTime?: string,
    breakMinutes = 60,
    shiftCategory = 'Morning Shift',
    hourlyRate = 3.000
  ): {
    totalHours: number;
    overtimeHours: number;
    calculatedPay: number;
    status: AttendanceRecord['status'];
  } {
    if (!checkOutTime) {
      return {
        totalHours: 0,
        overtimeHours: 0,
        calculatedPay: 0,
        status: 'Checked In'
      };
    }

    const parseTimeToMinutes = (t: string) => {
      const match = t.match(/(\d{1,2}):(\d{2})/);
      if (!match) return 0;
      return parseInt(match[1], 10) * 60 + parseInt(match[2], 10);
    };

    const inMin = parseTimeToMinutes(checkInTime);
    let outMin = parseTimeToMinutes(checkOutTime);
    if (outMin < inMin) {
      outMin += 24 * 60; // Crosses midnight
    }

    const grossMin = Math.max(0, outMin - inMin);
    const effBreak = Math.max(0, breakMinutes);
    const netMin = Math.max(0, grossMin - effBreak);
    const totalHours = Math.round((netMin / 60) * 100) / 100;

    const shift = this.shifts.find(s => s.name === shiftCategory);
    const standardHours = shift ? shift.standardHours : (this.attendanceSettings?.standardWorkHoursPerDay || 8);
    const overtimeThreshold = shift ? shift.overtimeThresholdHours : standardHours;
    const overtimeMultiplier = shift ? shift.overtimeRateMultiplier : (this.attendanceSettings?.overtimeMultiplier || 1.5);

    let overtimeHours = 0;
    if (totalHours > overtimeThreshold) {
      overtimeHours = Math.round((totalHours - overtimeThreshold) * 100) / 100;
    }

    const regularHours = Math.max(0, totalHours - overtimeHours);
    const pay = (regularHours * hourlyRate) + (overtimeHours * hourlyRate * overtimeMultiplier);
    const calculatedPay = Math.round(pay * 1000) / 1000;

    let status: AttendanceRecord['status'] = 'Completed';
    if (overtimeHours > 0) {
      status = 'Overtime';
    } else if (totalHours < (standardHours / 2)) {
      status = 'Half Day';
    }

    return {
      totalHours,
      overtimeHours,
      calculatedPay,
      status
    };
  }

  // Check In Employee
  public checkInEmployee(
    employeeId: number,
    options?: {
      checkInTime?: string;
      shiftCategory?: string;
      branch?: string;
      notes?: string;
    }
  ): AttendanceRecord | null {
    const emp = this.employees.find(e => e.id === employeeId);
    if (!emp) return null;

    const now = new Date();
    const dateStr = now.toISOString().slice(0, 10);
    const timeStr = options?.checkInTime || now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
    const shiftCat = options?.shiftCategory || emp.shiftCategory || 'Morning Shift';
    const branch = options?.branch || emp.branch || 'Main Branch - Mabellah Sanaya';

    // Check if already checked in today without checkout
    const existing = this.attendanceRecords.find(
      r => r.employeeId === employeeId && r.date === dateStr && !r.checkOutTime
    );

    if (existing) {
      return existing;
    }

    const shift = this.shifts.find(s => s.name === shiftCat);
    const breakMin = shift ? shift.defaultBreakMinutes : (this.attendanceSettings?.defaultBreakMinutes || 60);

    const nextId = this.attendanceRecords.length ? Math.max(...this.attendanceRecords.map(r => r.id)) + 1 : 1;
    const newRecord: AttendanceRecord = {
      id: nextId,
      employeeId: emp.id,
      employeeCode: emp.code,
      employeeName: emp.name,
      branch,
      date: dateStr,
      checkInTime: timeStr,
      checkOutTime: undefined,
      breakMinutes: breakMin,
      totalHours: 0,
      overtimeHours: 0,
      shiftCategory: shiftCat,
      status: 'Checked In',
      hourlyRate: emp.hourlyRate || 3.000,
      calculatedPay: 0,
      isApproved: false,
      notes: options?.notes || `Manager check-in recorded for ${emp.name}`
    };

    this.attendanceRecords.unshift(newRecord);
    this.logAudit(`Employee Check-In: ${emp.name} (${emp.code}) at ${timeStr}`, 'attendance', newRecord.id, 'manager', branch);
    this.addNotification({
      title: `Employee Checked In: ${emp.name}`,
      body: `Shift: ${shiftCat} | Time: ${timeStr} | Branch: ${branch}`,
      type: 'system'
    });
    this.persist();
    return newRecord;
  }

  // Check Out Employee
  public checkOutEmployee(
    recordId: number,
    options?: {
      checkOutTime?: string;
      breakMinutes?: number;
      notes?: string;
    }
  ): AttendanceRecord | null {
    const record = this.attendanceRecords.find(r => r.id === recordId);
    if (!record) return null;

    const now = new Date();
    const timeStr = options?.checkOutTime || now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
    const breakMin = options?.breakMinutes !== undefined ? options.breakMinutes : record.breakMinutes;

    const calc = this.calculateWorkingHoursAndPay(
      record.checkInTime,
      timeStr,
      breakMin,
      record.shiftCategory,
      record.hourlyRate
    );

    record.checkOutTime = timeStr;
    record.breakMinutes = breakMin;
    record.totalHours = calc.totalHours;
    record.overtimeHours = calc.overtimeHours;
    record.calculatedPay = calc.calculatedPay;
    record.status = calc.status;
    if (options?.notes) {
      record.notes = (record.notes ? record.notes + ' | ' : '') + options.notes;
    }

    this.logAudit(
      `Employee Check-Out: ${record.employeeName} (${record.totalHours} hrs, ${record.calculatedPay.toFixed(3)} OMR)`,
      'attendance',
      record.id,
      'manager',
      record.branch
    );
    this.addNotification({
      title: `Employee Checked Out: ${record.employeeName}`,
      body: `Worked: ${record.totalHours} hrs | Pay: ${record.calculatedPay.toFixed(3)} OMR`,
      type: 'system'
    });

    this.persist();
    return record;
  }

  // Save / Update Attendance Record (manual edit or timestamp adjustment)
  public saveAttendanceRecord(rec: Partial<AttendanceRecord> & { employeeId: number }): AttendanceRecord {
    const emp = this.employees.find(e => e.id === rec.employeeId);
    const empName = emp ? emp.name : rec.employeeName || 'Staff Member';
    const empCode = emp ? emp.code : rec.employeeCode || 'EMP-000';
    const hourlyRate = rec.hourlyRate || emp?.hourlyRate || 3.000;
    const shiftCat = rec.shiftCategory || emp?.shiftCategory || 'Morning Shift';
    const breakMin = rec.breakMinutes !== undefined ? rec.breakMinutes : 60;

    let totalHours = rec.totalHours || 0;
    let overtimeHours = rec.overtimeHours || 0;
    let calculatedPay = rec.calculatedPay || 0;
    let status = rec.status || 'Checked In';

    if (rec.checkInTime && rec.checkOutTime) {
      const calc = this.calculateWorkingHoursAndPay(
        rec.checkInTime,
        rec.checkOutTime,
        breakMin,
        shiftCat,
        hourlyRate
      );
      totalHours = calc.totalHours;
      overtimeHours = calc.overtimeHours;
      calculatedPay = calc.calculatedPay;
      status = calc.status;
    }

    let savedRecord: AttendanceRecord;
    if (rec.id) {
      const idx = this.attendanceRecords.findIndex(r => r.id === rec.id);
      if (idx !== -1) {
        savedRecord = {
          ...this.attendanceRecords[idx],
          ...rec,
          employeeName: empName,
          employeeCode: empCode,
          hourlyRate,
          shiftCategory: shiftCat,
          breakMinutes: breakMin,
          totalHours,
          overtimeHours,
          calculatedPay,
          status
        };
        this.attendanceRecords[idx] = savedRecord;
      } else {
        savedRecord = {
          ...(rec as AttendanceRecord),
          id: rec.id,
          employeeName: empName,
          employeeCode: empCode,
          hourlyRate,
          shiftCategory: shiftCat,
          breakMinutes: breakMin,
          totalHours,
          overtimeHours,
          calculatedPay,
          status,
          date: rec.date || new Date().toISOString().slice(0, 10),
          checkInTime: rec.checkInTime || '08:00',
          branch: rec.branch || 'Main Branch - Mabellah Sanaya',
          isApproved: rec.isApproved || false
        };
        this.attendanceRecords.unshift(savedRecord);
      }
    } else {
      const nextId = this.attendanceRecords.length ? Math.max(...this.attendanceRecords.map(r => r.id)) + 1 : 1;
      savedRecord = {
        id: nextId,
        employeeId: rec.employeeId,
        employeeCode: empCode,
        employeeName: empName,
        branch: rec.branch || emp?.branch || 'Main Branch - Mabellah Sanaya',
        date: rec.date || new Date().toISOString().slice(0, 10),
        checkInTime: rec.checkInTime || '08:00',
        checkOutTime: rec.checkOutTime,
        breakMinutes: breakMin,
        totalHours,
        overtimeHours,
        shiftCategory: shiftCat,
        status,
        hourlyRate,
        calculatedPay,
        isApproved: rec.isApproved || false,
        notes: rec.notes
      };
      this.attendanceRecords.unshift(savedRecord);
    }

    this.logAudit(`Attendance timestamp saved for ${savedRecord.employeeName}`, 'attendance', savedRecord.id);
    this.persist();
    return savedRecord;
  }

