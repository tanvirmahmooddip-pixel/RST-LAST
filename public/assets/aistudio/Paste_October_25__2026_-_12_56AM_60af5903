  }

  public convertQuotationToInvoice(quoteId: number): Invoice | null {
    const quote = this.quotations.find(q => q.id === quoteId);
    if (!quote) return null;

    const nextId = this.invoices.length ? Math.max(...this.invoices.map(i => i.id)) + 1 : 1;
    const invoiceNo = `RST-${String(nextId).padStart(5, '0')}`;
    
    // Estimate profit
    const costTotal = quote.items.reduce((sum, it) => sum + ((it.cost || it.price * 0.8) * it.qty), 0);
    const profit = Math.max(0, quote.subtotal - quote.discount - costTotal);

    const invoice: Invoice = {
      id: nextId,
      invoice_no: invoiceNo,
      date: new Date().toISOString(),
      customer: quote.customer_name,
      customer_id: quote.customer_id,
      items: quote.items.map(it => ({
        id: it.id,
        name: it.name,
        price: it.price,
        cost: it.cost || (it.price * 0.8),
        qty: it.qty,
        isComponent: it.isComponent,
        barcode: it.sku || generateEAN13(),
        imei: it.name.toLowerCase().includes('phone') || it.name.toLowerCase().includes('ultra') ? generateIMEI() : undefined
      })),
      subtotal: quote.subtotal,
      discount: quote.discount,
      vat: quote.vat,
      grand_total: quote.grand_total,
      payment: 'Cash',
      profit,
      branch: 'Main Branch - Mabellah Sanaya',
      operator: 'admin',
      status: 'Paid'
    };

    this.invoices.unshift(invoice);
    quote.status = 'Converted';
    this.logAudit(`Converted Quotation ${quote.quote_no} to Tax Invoice ${invoice.invoice_no}`, 'invoice', invoice.id);
    this.persist();
    return invoice;
  }

