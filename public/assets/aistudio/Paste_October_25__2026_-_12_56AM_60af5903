        cart={cart}
        onOpenCart={() => setCurrentPage('pos')}
        onNavigate={setCurrentPage}
        onToggleMobileSidebar={() => setMobileSidebarOpen(!mobileSidebarOpen)}
        onTriggerEmergencyTest={handleTriggerEmergency}
        onStopEmergency={handleStopEmergency}
        isEmergencyActive={isEmergencyActive}
      />

      <div className="flex-1 flex overflow-hidden">
        {/* Sidebar */}
        <Sidebar
          currentPage={currentPage}
          onNavigate={setCurrentPage}
          lang={lang}
          currentUser={currentUser}
          onLogout={handleLogout}
          mobileOpen={mobileSidebarOpen}
          onCloseMobile={() => setMobileSidebarOpen(false)}
        />

        {/* Main Content Viewport */}
        <main className="flex-1 lg:pl-64 p-4 sm:p-6 lg:p-8 overflow-y-auto max-w-7xl mx-auto w-full transition-all">
          {currentPage === 'dashboard' && (
            <DashboardView
              lang={lang}
              onNavigate={setCurrentPage}
              currentUser={currentUser}
              onTriggerEmergency={handleTriggerEmergency}
              onStopEmergency={handleStopEmergency}
              isEmergencyActive={isEmergencyActive}
              onDataRefresh={() => setTick(t => t + 1)}
            />
          )}

          {currentPage === 'catalog' && (
            <ComponentCatalog
              components={db.components}
              onAddToCart={handleAddToCart}
              lang={lang}
              onRefreshComponents={() => setTick((t) => t + 1)}
            />
          )}

          {currentPage === 'pos' && (
            <POSInvoicing
              cart={cart}
              onUpdateQty={handleUpdateQty}
              onRemoveItem={handleRemoveItem}
              onClearCart={handleClearCart}
              onAddToCart={handleAddToCart}
              lang={lang}
              onInvoiceCreated={handleInvoiceCreated}
            />
          )}

          {currentPage === 'phones' && (
            <PhoneModelsCatalog
              lang={lang}
              currentUser={currentUser}
              onAddToCart={handleAddToCart}
              onNavigate={setCurrentPage}
            />
          )}

          {currentPage === 'sql' && (
            <SqlStudio
              lang={lang}
              onDataMutated={() => setTick((t) => t + 1)}
            />
          )}

          {currentPage === 'inventory' && (
            <InventoryManager
              lang={lang}
              onRefresh={() => setTick((t) => t + 1)}
            />
          )}

          {currentPage === 'barcode' && (
            <BarcodeStudio
              lang={lang}
            />
          )}

          {currentPage === 'telecom' && (
            <TelecomUtility
              lang={lang}
            />
          )}

          {currentPage === 'accounts' && (
            <AccountsProfit
              lang={lang}
            />
          )}

          {currentPage === 'customers' && (
            <CustomersManager
              lang={lang}
            />
          )}

          {currentPage === 'warranty' && (
            <WarrantyInstallment
              lang={lang}
            />
          )}

          {currentPage === 'adminCenter' && (
            <AdminCenter
              lang={lang}
              currentUser={currentUser}
              onRefresh={() => setTick(t => t + 1)}
            />
          )}

          {currentPage === 'visitor' && (
            <VisitorLandingPage
              lang={lang}
              onLanguageChange={handleLanguageChange}
              onGoToLogin={handleLogout}
              onOpenApp={() => setCurrentPage('dashboard')}
              isLoggedIn={true}
            />
          )}

          {currentPage === 'settings' && (
            <div className="p-4 bg-slate-900 rounded-2xl border border-slate-800">
              <button
                onClick={() => setIsSettingsOpen(true)}
                className="bg-emerald-600 text-white font-bold px-4 py-2 rounded-xl text-xs"
              >
                Open System Configuration Panel
              </button>
            </div>
          )}
        </main>
      </div>

      {/* Emergency Siren Modal Alert Popup (when siren is actively ringing) */}
      {isEmergencyActive && (
        <div className="fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4">
          <div className="bg-slate-900 border-2 border-rose-600 rounded-3xl max-w-md w-full p-6 text-center space-y-4 shadow-2xl animate-in zoom-in-95 duration-200">
            <div className="w-16 h-16 rounded-full bg-rose-600/20 text-rose-500 border border-rose-500/30 flex items-center justify-center mx-auto animate-bounce">
              <ShieldAlert className="w-9 h-9" />
            </div>

            <div>
              <h2 className="text-xl font-black text-rose-400 tracking-tight uppercase">
                🚨 EMERGENCY SIREN ACTIVE
              </h2>
              <p className="text-xs text-slate-300 font-mono mt-1">
                {db.activeEmergency?.message || 'High-priority financial / security alert triggered.'}
              </p>
            </div>

            <div className="bg-slate-950 p-3 rounded-xl border border-slate-800 text-xs font-mono text-slate-400">
              Time Triggered: {db.activeEmergency?.timestamp || new Date().toLocaleTimeString()}
            </div>

            {currentUser?.role === 'admin' ? (
              <button
                onClick={handleStopEmergency}
                className="w-full py-3 bg-white hover:bg-slate-100 text-rose-700 font-black rounded-xl text-sm transition shadow-xl flex items-center justify-center gap-2"
              >
                <StopCircle className="w-5 h-5 text-rose-700" />
                <span>STOP EMERGENCY SIREN (ADMIN)</span>
              </button>
            ) : (
              <div className="p-3 bg-rose-950/60 border border-rose-900 text-rose-300 text-xs rounded-xl font-mono">
                🔒 You are logged in as {currentUser?.username}. Only System Administrator can stop the emergency alert.
              </div>
            )}
          </div>
        </div>
      )}

      {/* Floating AI Assistant Copilot */}
      <AiAssistant />

      {/* Slide-out Notification Drawer */}
      <NotificationDrawer
        isOpen={isNotifOpen}
        onClose={() => setIsNotifOpen(false)}
        onClear={() => {
          db.notifications = [];
          setTick((t) => t + 1);
        }}
      />

      {/* System Settings Modal */}
      <SettingsModal
        isOpen={isSettingsOpen || currentPage === 'settings'}
        onClose={() => {
          setIsSettingsOpen(false);
          if (currentPage === 'settings') setCurrentPage('dashboard');
          setTick((t) => t + 1);
        }}
        lang={lang}
      />
    </div>
  );

