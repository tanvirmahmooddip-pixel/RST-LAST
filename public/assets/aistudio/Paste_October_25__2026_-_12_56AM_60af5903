      readTime: post.readTime || '3 min read',
      published: post.published !== false
    };

    posts.unshift(newPost);
    this.config.landingPage.blogPosts = posts;
    this.persist();
    return newPost;
  }

  public updateBlogPost(id: number, updates: Partial<BlogPost>): BlogPost | null {
    if (!this.config.landingPage?.blogPosts) return null;
    const idx = this.config.landingPage.blogPosts.findIndex(p => p.id === id);
    if (idx === -1) return null;
    this.config.landingPage.blogPosts[idx] = { ...this.config.landingPage.blogPosts[idx], ...updates };
    this.persist();
    return this.config.landingPage.blogPosts[idx];
  }

  public deleteBlogPost(id: number): boolean {
    if (!this.config.landingPage?.blogPosts) return false;
    const idx = this.config.landingPage.blogPosts.findIndex(p => p.id === id);
    if (idx === -1) return false;
    this.config.landingPage.blogPosts.splice(idx, 1);
    this.persist();
    return true;
  }

