  const [currentUser, setCurrentUser] = useState<User | null>(() => {
    const saved = localStorage.getItem('rst_user');
    return saved ? JSON.parse(saved) : (db.users?.[0] || {
      id: 1,
      username: 'admin',
      fullname: 'System Administrator',
      role: 'admin',
      branch: 1
    });
  });

  // Language & Direction
  const [lang, setLang] = useState<Language>(() => {
    return (localStorage.getItem('rst_lang') as Language) || 'en';
  });

  // Active view
  const [currentPage, setCurrentPage] = useState<string>('dashboard');

  // Shared cart state
  const [cart, setCart] = useState<CartItem[]>(() => {
    const saved = localStorage.getItem('rst_cart');
    return saved ? JSON.parse(saved) : [];
  });

  // Audio feedback
  const [soundEnabled, setSoundEnabled] = useState<boolean>(() => {
    return localStorage.getItem('rst_sound') !== 'false';
  });

  // Emergency Siren State
  const [isEmergencyActive, setIsEmergencyActive] = useState<boolean>(() => {
    return db.activeEmergency?.active || false;
  });

  // UI drawers & modals
  const [mobileSidebarOpen, setMobileSidebarOpen] = useState(false);
  const [isNotifOpen, setIsNotifOpen] = useState(false);
  const [isSettingsOpen, setIsSettingsOpen] = useState(false);
  const [isVisitorMode, setIsVisitorMode] = useState(false);
  const [tick, setTick] = useState(0);

  // Sync direction with language
  useEffect(() => {
    localStorage.setItem('rst_lang', lang);
    document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
    document.documentElement.lang = lang;
  }, [lang]);

  // Sync cart
  useEffect(() => {
    localStorage.setItem('rst_cart', JSON.stringify(cart));
  }, [cart]);

  // Sync sound
  useEffect(() => {
    SoundEngine.enabled = soundEnabled;
    localStorage.setItem('rst_sound', String(soundEnabled));
  }, [soundEnabled]);

  const handleLanguageChange = (newLang: Language) => {
    SoundEngine.click();
    setLang(newLang);
  };

  const handleLogin = (user: User) => {
    setCurrentUser(user);
    setIsVisitorMode(false);
    localStorage.setItem('rst_user', JSON.stringify(user));
  };

  const handleLogout = () => {
    setCurrentUser(null);
    localStorage.removeItem('rst_user');
    SoundEngine.click();
  };

  // Emergency Handlers
  const handleTriggerEmergency = () => {
    db.triggerEmergencyAlert(
      'CASH REGISTER & EMERGENCY DISCREPANCY',
      'Emergency alert siren triggered on system dashboard. Admin intervention required.'
    );
    setIsEmergencyActive(true);
    setTick(t => t + 1);
  };

  const handleStopEmergency = () => {
    if (currentUser?.role !== 'admin') {
      alert('Only Admin ID is authorized to silence this emergency alert.');
      return;
    }
    db.stopEmergencyAlert(currentUser.fullname);
    setIsEmergencyActive(false);
    setTick(t => t + 1);
  };

  const handleAddToCart = (item: CartItem) => {
    setCart((prevCart) => {
      const existing = prevCart.find((i) => i.id === item.id && i.isComponent === item.isComponent);
      if (existing) {
        return prevCart.map((i) =>
          i.id === item.id && i.isComponent === item.isComponent
            ? { ...i, qty: i.qty + item.qty }
            : i
        );
      }
      return [...prevCart, item];
    });
  };

  const handleUpdateQty = (index: number, newQty: number) => {
    if (newQty <= 0) {
      handleRemoveItem(index);
      return;
    }
    setCart((prev) => {
      const updated = [...prev];
      updated[index] = { ...updated[index], qty: newQty };
      return updated;
    });
  };

  const handleRemoveItem = (index: number) => {
    setCart((prev) => prev.filter((_, i) => i !== index));
  };

  const handleClearCart = () => {
    setCart([]);
  };

  const handleInvoiceCreated = (invoice: Invoice) => {
    setTick((t) => t + 1);
  };

  // Redirect away from hidden pages
  useEffect(() => {
    if (currentUser?.hiddenPages?.includes(currentPage)) {
      setCurrentPage('dashboard');
    }
  }, [currentUser, currentPage]);

  if (!currentUser) {
    if (isVisitorMode) {
      return (
        <VisitorLandingPage
          lang={lang}
          onLanguageChange={handleLanguageChange}
          onGoToLogin={() => setIsVisitorMode(false)}
        />
      );
    }

    return (
      <LoginScreen
        onLogin={handleLogin}
        lang={lang}
        onLanguageChange={handleLanguageChange}
        onViewShowcase={() => setIsVisitorMode(true)}
      />
    );
  }

  const unreadNotifsCount = db.notifications.filter((n) => !n.read).length;

  const themePreset = db.config.themePreset || 'emerald';
  const fontScale = db.config.fontScale || 'normal';

  const themeClasses = useMemo(() => {
    let bg = 'bg-slate-950 text-slate-100';
    if (themePreset === 'obsidian') bg = 'bg-black text-neutral-100';
    else if (themePreset === 'sapphire') bg = 'bg-slate-950 text-sky-100';
    else if (themePreset === 'amethyst') bg = 'bg-slate-950 text-purple-100';
    else if (themePreset === 'solar') bg = 'bg-stone-950 text-amber-100';
    else if (themePreset === 'cyberpunk') bg = 'bg-slate-950 text-rose-100';

    let font = 'text-sm';
    if (fontScale === 'compact') font = 'text-[13px]';
    else if (fontScale === 'spacious') font = 'text-base';

    return `${bg} ${font}`;
  }, [themePreset, fontScale, tick]);

  return (
    <div className={`min-h-screen ${themeClasses} flex flex-col font-sans transition-colors duration-300`}>
      {/* Top Header */}
      <Header
        lang={lang}
        onLanguageChange={handleLanguageChange}
        currentUser={currentUser}
        onLogout={handleLogout}
        soundEnabled={soundEnabled}
        onToggleSound={() => setSoundEnabled(!soundEnabled)}
